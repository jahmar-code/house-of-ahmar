# House of Ahmar — environment contract
#
# Copy to `.env.local` and fill in. Every variable below is read somewhere in
# `src/` or `scripts/`; nothing here is decorative.
#
#   cp .env.example .env.local
#
# The REQUIRED block is validated at boot by `src/lib/env.ts` — if one is missing
# the app throws a named MissingEnvError instead of a blank white screen.
#
# ⚠️  NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time.
#     Changing one needs a rebuild (`npm run build`), not just a restart.


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED — the app will not run without these
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project URL. Dashboard → Project Settings → Data API → Project URL.
# Read by: src/lib/supabase/{client,server,middleware}.ts, src/lib/env.ts,
#          src/app/actions/members.ts (avatar same-origin check), next.config.ts.
# Missing → boot throws MissingEnvError; avatar uploads lose their origin check.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (the key formerly called "anon"). Safe to ship to the
# browser — the complete migration chain denies the Data API by default.
# Dashboard → Project Settings → API Keys → publishable.
# Missing → every page throws "supabaseUrl is required" in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Postgres connection string. Dashboard → Project Settings → Database →
# Connection string → URI. This is the OWNER role: it bypasses RLS entirely, so
# every authorization decision the app makes is the app's own (see the
# AGENTS.md invariants).
# Read by: src/lib/db/index.ts, drizzle.config.ts, backup.mjs and the read-only
# or idempotent ops scripts in scripts/. Test scripts use .env.e2e.local only.
# Missing → postgres.js silently defaults to localhost and the first query dies
#           with a misleading ECONNREFUSED, so env.ts checks it up front.
# ⚠️  A real secret. Never commit it, never paste it into an issue.
DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.your-project-ref.supabase.co:5432/postgres


# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED FOR THE FIRST EVER SIGN-UP — then it should be removed
# ─────────────────────────────────────────────────────────────────────────────

# The bootstrap code that lets the very first person in. Codes can otherwise only
# be minted by an Elder, and the first person to join becomes the Elder — so an
# empty House with this unset can never be entered by anyone (CLAUDE.md Critical
# rule #1). It is retired once any member exists and cannot be reused as a
# standing invite. Remove it after the founding Elder joins as cleanup.
# Read by: src/app/actions/onboarding.ts.
HOA_DEFAULT_ACCESS_CODE=change-me-then-delete-me


# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — but strongly recommended in production
# ─────────────────────────────────────────────────────────────────────────────

# The House's public origin. Pins auth confirmation emails and the
# post-confirmation redirect to the real domain.
# Read by: src/lib/get-url.ts, src/app/layout.tsx (metadataBase), src/lib/env.ts.
# Missing → browser links use configured Vercel origins or the current origin;
# server fallback is localhost. Set this explicitly for reliable production links.
# Must ALSO be added in Supabase → Authentication → URL Configuration
# (Site URL, and Redirect URLs including <url>/auth/confirm).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Injected automatically by Vercel — do not set these by hand. Listed only so
# the contract is complete: they are the second and third fallbacks in
# src/lib/get-url.ts when NEXT_PUBLIC_SITE_URL is absent.
# NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
# VERCEL_URL=


# ─────────────────────────────────────────────────────────────────────────────
# OPS SCRIPTS ONLY — never read by the app
# ─────────────────────────────────────────────────────────────────────────────

# Supabase service_role key. Dashboard → Project Settings → API Keys → secret.
# Bypasses RLS and every authorization rule in the House. It is read ONLY by
# scripts/backup.mjs and scripts/restore.mjs (Storage half) — no application code
# touches it, and it must never be given a NEXT_PUBLIC_ prefix.
# Missing → those two scripts refuse to run. The app is unaffected.
# ⚠️  The most dangerous value in this file.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
